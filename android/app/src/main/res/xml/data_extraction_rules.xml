<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Mesma regra: incluir a base do utilizador chega, tanto para
  a cópia na nuvem como para a transferência entre dispositivos. Mudar de
  telemóvel leva as palavras registadas; o dicionário reinstala-se do APK.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="utilizador.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="utilizador.db" />
    </device-transfer>
</data-extraction-rules>
