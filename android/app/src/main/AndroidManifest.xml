<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Não há <uses-permission android:name="android.permission.INTERNET" />
      e é de propósito (plano, F2): sem permissão de rede, é impossível
      haver uma dependência escondida de um servidor. Tudo o que a app
      mostra vem do dicionario.db que está no dispositivo.

      Continua a ser verdade com o modo jogo: o lembrete diário decide-se
      inteiramente no telemóvel, a partir da utilizador.db.
    -->

    <!--
      Só para o lembrete diário do modo jogo, e pedida no momento em que
      esse modo é ligado nas Definições — não ao arrancar. Quem nunca ligar
      o jogo nunca vê este pedido.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PalavrameApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Palavrame">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A funcionalidade mais valiosa do projeto (plano F4, antecipada
              para a F2): selecionar uma palavra em qualquer app — incluindo
              o leitor de e-books — e enviá-la direto para aqui.
            -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              O mesmo gesto pelo "Partilhar", para os leitores que não mostram
              a Palavra-me no menu de seleção de texto (o Kindle, por exemplo)
              mas deixam partilhar a passagem selecionada.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              O "procurar no dicionário" dos leitores de e-books (1.31): o
              ReadEra, o Moon+, o FBReader e outros não usam o menu de seleção
              nem o "Partilhar", chamam uma app de dicionário pelos pedidos
              que o ColorDict e o Aard 2 tornaram habituais. Respondendo a
              eles, a Palavra-me aparece na lista de dicionários desses
              leitores. A pesquisa padrão do Android vai pelo mesmo caminho.
              Ver `PedidoDeTexto`.
            -->
            <intent-filter>
                <action android:name="colordict.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="aard2.lookup" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          A imagem de "Partilhar palavra": grava-se na cache (partilha/) e
          entrega-se à app escolhida por este provider, só com leitura e só
          para essa partilha. Não abre nada mais da app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.partilha"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/partilha_paths" />
        </provider>
    </application>
</manifest>
